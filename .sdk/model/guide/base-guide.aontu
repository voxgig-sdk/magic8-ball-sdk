# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 3
  metrics: count: path: 4
  metrics: count: method: 5

  entity: biased: {
    path: "/api/biased": {
      op: create: method: *POST
      op: create: transform: res: *("`body.sentiment`")|top
      op: load: method: *GET
      op: load: transform: res: *("`body.sentiment`")|top
    }
  }

  entity: category: {
    path: "/api/categories": {
      op: list: method: *GET
    }
  }

  entity: category_fortune: {
    path: "/api": {
      op: load: method: *GET
    }
    path: "/api/{category}": {
      op: load: method: *GET
    }
  }

}